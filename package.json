{
  "name": "crunchbase-scraper",
  "version": "1.0.0",
  "description": "Production-ready Apify Actor that scrapes Crunchbase for company and funding data. Supports company URLs, names, and industry/location search.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsc --watch"
  },
  "keywords": [
    "crunchbase",
    "scraper",
    "startup-data",
    "funding",
    "investor-data",
    "company-intelligence",
    "b2b-data",
    "apify-actor"
  ],
  "author": "crunchbase-scraper-dev",
  "license": "Apache-2.0",
  "dependencies": {
    "apify": "^3.1.0",
    "crawlee": "^3.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "playwright": "^1.41.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "apify": {
    "actorSpecification": 1
  }
}
